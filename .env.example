# Copiez ce fichier en .env.local et renseignez vos propres identifiants.
# .env.local n'est jamais commité (voir .gitignore).

# SMTP de la boîte contact@f1actu.fr (exemple pour OVH)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@f1actu.fr
SMTP_PASSWORD=

# Adresse qui recevra les messages du formulaire de contact
CONTACT_EMAIL=contact@f1actu.fr
